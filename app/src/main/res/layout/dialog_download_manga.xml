<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Manga"
            android:textColor="#1D1B20"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvMangaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Manga Name"
            android:textColor="#49454F"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="1">

            <RadioGroup
                android:id="@+id/rgDownloadOptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkedButton="@+id/rbWholeManga">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbWholeManga"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:text="All Chapters"
                    android:textColor="#1D1B20"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:buttonTint="@color/blue_medium" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbTranslatedChapters"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:text="All translated chapters (English)"
                    android:textColor="#1D1B20"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:buttonTint="@color/blue_medium" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbCustomChapters"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:text="First 5 chapters"
                    android:textColor="#1D1B20"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:buttonTint="@color/blue_medium" />

            </RadioGroup>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvAllChapters"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:text="131 chapters"
                    android:textColor="#79747E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTranslatedChapters"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="47 chapters\nEnglish"
                    android:textAlignment="center"
                    android:textColor="#79747E"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgCustomChapters"
                    android:layout_width="24dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="center"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="Dropdown Arrow"
                    app:tint="#49454F" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Hủy"
                app:icon="@null"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/blue_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bắt đầu tải"
                app:icon="@null"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/blue_medium"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>