<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRandom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_search_view"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_author"
            android:drawableTint="?attr/icon"
            android:paddingHorizontal="@dimen/padding_horizontal_large"
            android:paddingVertical="@dimen/padding_vertical_large"
            android:layout_margin="@dimen/margin_medium2"
            android:text="Random"
            android:textColor="?attr/textTitle"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBookMark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_search_view"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_bookmark"
            android:drawableTint="?attr/icon"
            android:paddingHorizontal="@dimen/padding_horizontal_large"
            android:paddingVertical="@dimen/padding_vertical_large"
            android:layout_margin="@dimen/margin_medium2"
            android:text="Bookmarks"
            android:textColor="?attr/textTitle"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFavourite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_search_view"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_author"
            android:drawableTint="?attr/icon"
            android:paddingHorizontal="@dimen/padding_horizontal_large"
            android:paddingVertical="@dimen/padding_vertical_large"
            android:layout_margin="@dimen/margin_medium2"
            android:text="Favourite"
            android:textColor="?attr/textTitle"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_search_view"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_bookmark"
            android:drawableTint="?attr/icon"
            android:paddingHorizontal="@dimen/padding_horizontal_large"
            android:paddingVertical="@dimen/padding_vertical_large"
            android:layout_margin="@dimen/margin_medium2"
            android:text="Download"
            android:textColor="?attr/textTitle"/>
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Genres"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvShowMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show more"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="8dp"/>

            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="false"/>

        </LinearLayout>


</LinearLayout>