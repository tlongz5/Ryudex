<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDownloadTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tải truyện"
        android:textColor="@color/blue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCurrentSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ĐANG TẢI"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDownloadTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrentDownload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E3F2FD"
        app:strokeColor="#BBDEFB"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutCurrentDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="100dp"
                app:strokeWidth="0dp"
                android:layout_gravity="center"
                app:cardCornerRadius="16dp">
                <ImageView
                    android:id="@+id/imgCurrentCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCurrentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên truyện đang tải"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvCurrentChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chapter 12 / 50"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/progressCurrent"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="45"
                    android:progressTint="@color/blue"
                    android:progressBackgroundTint="#BBDEFB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/blue"
                    app:cornerRadius="20dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvQueueSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="HÀNG CHỜ"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardCurrentDownload"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueuedDownloads"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvQueueSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>